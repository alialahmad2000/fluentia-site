{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/test",
      "destination": "/level-test",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "fluentia.online"
        }
      ],
      "destination": "https://fluentia.academy/",
      "permanent": true
    },
    {
      "source": "/legacy",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fluentia.online"
        }
      ],
      "destination": "https://fluentia.academy/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fluentia-site.vercel.app"
        }
      ],
      "destination": "https://fluentia.academy/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/level-test",
      "destination": "/level-test.html"
    },
    {
      "source": "/start",
      "destination": "/start.html"
    },
    {
      "source": "/partners",
      "destination": "/partners.html"
    },
    {
      "source": "/partners/terms",
      "destination": "/partners/terms.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/articles",
      "destination": "/articles.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/articles/%D9%84%D9%8A%D8%B4-%D9%85%D8%A7-%D8%AA%D8%AA%D9%83%D9%84%D9%85-%D8%A7%D9%86%D8%AC%D9%84%D9%8A%D8%B2%D9%8A",
      "destination": "/articles/ليش-ما-تتكلم-انجليزي.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
