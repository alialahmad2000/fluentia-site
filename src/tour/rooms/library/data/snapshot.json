  "paragraphs": [
    {
      "id": "7b3ea73e-dd52-4cb6-9abb-81f4c572ce6d",
      "index": 0,
      "sentences": [
        {
          "id": "c72d6f2c-4340-4474-a2c7-6e27701347f4",
          "sentence_index": 0,
          "text_en": "The winter that the wolves came was the hardest winter the village of Stonehollow had ever known.",
          "text_ar": "كان الشتاء الذي جاءت فيه الذئاب أقسى شتاءٍ عرفته قرية «ستونهولو».",
          "is_dialogue": false,
          "speaker": "narrator"
        },
        {
          "id": "69a87a28-e818-47d6-b716-3b487cbd0338",
          "sentence_index": 1,
          "text_en": "The snow began in October and did not stop, and by December it had buried the low houses to their windows and closed the mountain road completely.",
          "text_ar": "بدأ الثلج في أكتوبر ولم يتوقّف، وبحلول ديسمبر كان قد دفن البيوت المنخفضة حتى نوافذها، وأغلق طريق الجبل تماماً.",
          "is_dialogue": false,
          "speaker": "narrator"
        }
      ]
    },
    {
      "id": "61478ea3-149d-4706-8033-d4fb218c2f4e",
      "index": 1,
      "sentences": [
        {
          "id": "aac8ef33-ca0c-42cd-ac0f-7667d40a4736",
          "sentence_index": 0,
          "text_en": "The village sat alone in a white world, cut off from everything below.",
          "text_ar": "جلست القرية وحدها في عالمٍ أبيض، مقطوعةً عن كلّ ما في الأسفل.",
          "is_dialogue": false,
          "speaker": "narrator"
        },
        {
          "id": "0cf20030-850e-404b-bcca-29223e2921e7",
          "sentence_index": 1,
          "text_en": "And in the long blue evenings, when the cold came down hard from the peaks, the people heard a new sound — the howling of wolves.",
          "text_ar": "وفي الأمسيات الزرقاء الطويلة، حين يهبط البرد قاسياً من القمم، سمع الناس صوتاً جديداً — عواء الذئاب.",
          "is_dialogue": false,
          "speaker": "narrator"
        }
      ]
    },
    {
      "id": "e825856b-b97c-446b-85cf-a9451a1369ca",
      "index": 2,
      "sentences": [
        {
          "id": "db6ca29a-f834-4140-85ce-253dd6b8e85c",
          "sentence_index": 0,
          "text_en": "No one in Stonehollow could remember the wolves ever coming so close.",
          "text_ar": "لم يستطع أحدٌ في «ستونهولو» أن يتذكّر أنّ الذئاب اقتربت يوماً إلى هذا الحد.",
          "is_dialogue": false,
          "speaker": "narrator"
        },
        {
          "id": "ac179fde-4572-4579-a5c1-cc19c1fd7c7c",
          "sentence_index": 1,
          "text_en": "They lived high in the far forests, the old people said, and they kept to themselves.",
          "text_ar": "كانت تعيش عالياً في الغابات البعيدة، قال العجائز، وتبقى في حالها.",
          "is_dialogue": false,
          "speaker": "narrator"
        },
        {
          "id": "307c95c8-c6a1-4b9e-8805-99489bee1d16",
          "sentence_index": 2,
          "text_en": "But this winter was different, and the wolves had come down.",
          "text_ar": "لكنّ هذا الشتاء كان مختلفاً، والذئاب نزلت.",
          "is_dialogue": false,
          "speaker": "narrator"
        }
      ]
    },
    {
      "id": "8d98c4a3-5cda-492a-9ac1-9e339769848d",
      "index": 3,
      "sentences": [
        {
          "id": "f6b5a8ec-8bd9-4f9a-aa5c-90530f4c7c5e",
          "sentence_index": 0,
          "text_en": "Reni was sixteen, and she was not afraid of the howling the way the others were.",
          "text_ar": "كانت ريني في السادسة عشرة، ولم تكن تخاف من العواء كما يخاف الآخرون.",
          "is_dialogue": false,
          "speaker": "narrator"
        },
        {
          "id": "6f80258f-34b5-4aaf-9cd4-44fb46b12dd3",
          "sentence_index": 1,
          "text_en": "She would stand at the edge of the village in the falling snow and listen, and the sound did not seem cruel to her — only lonely, and very cold.",
          "text_ar": "كانت تقف عند طرف القرية في الثلج المتساقط وتُصغي، ولم يبدُ لها الصوت قاسياً — بل وحيداً فحسب، وبارداً جداً.",
          "is_dialogue": false,
          "speaker": "narrator"
        }
      ]
    },
    {
      "id": "f803f452-80b0-4ed1-b068-695751e12ad9",
      "index": 4,
      "sentences": [
        {
          "id": "0c2cbdb9-3200-4825-b44a-9689251f2c31",
          "sentence_index": 0,
          "text_en": "Her father, Joren, was the head of the village hunters, and he did not listen for loneliness in the dark.",
          "text_ar": "كان أبوها، جورن، رئيس صيّادي القرية، ولم يكن يُصغي إلى الوحدة في الظلام.",
          "is_dialogue": false,
          "speaker": "narrator"
        },
        {
          "id": "6fe06bd6-963f-423d-8418-4ec190123bfe",
          "sentence_index": 1,
          "text_en": "\"A hungry wolf is a dangerous wolf,\" he told her. \"When the snow traps them and us together, one of us has to lose.\"",
          "text_ar": "«الذئب الجائع ذئبٌ خطير»، قال لها. «حين يحبسنا الثلج معاً، لا بدّ أن يخسر أحدنا.»",
          "is_dialogue": true,
          "speaker": "Joren"
        },
        {
          "id": "ab663dbb-ce46-47f5-a010-5495eeea46ae",
          "sentence_index": 2,
          "text_en": "He had set iron traps along the forest edge, and he meant to use them.",
          "text_ar": "نصب فخاخاً حديدية على حافّة الغابة، وكان عازماً على استخدامها.",
          "is_dialogue": false,
          "speaker": "narrator"
        }
      ]
    }
  ],
  "questions": [
    {
      "id": "5ab3147f-ded7-4ed0-a526-787b6fc56c04",
      "q_index": 1,
      "type": "comprehension",
      "question_en": "Why had the wolves come down to Stonehollow this winter?",
      "question_ar": "لماذا نزلت الذئاب إلى «ستونهولو» في هذا الشتاء؟",
      "options": [
        {
          "en": "They had always lived near the village",
          "id": "A"
        },
        {
          "en": "They were starving and the deep snow had trapped them",
          "id": "B"
        },
        {
          "en": "Reni called them with her howling",
          "id": "C"
        },
        {
          "en": "The hunters drove them down",
          "id": "D"
        }
      ],
      "correct_id": "B",
      "explanation_ar": "الثلوج العميقة قطعت طريق صيد الذئاب فنزلت جوعى، أول إشارة أن الذئاب ضحية لا عدوّ.",
      "jump_p": 4,
      "jump_s": 1
    },
    {
      "id": "5e8aadda-83c7-4442-af94-77c3acbb1462",
      "q_index": 2,
      "type": "inference",
      "question_en": "The howling seemed to Reni \"only lonely, and very cold.\" This shows that she —",
      "question_ar": "بدا العواء لريني «وحيداً فحسب، وبارداً جداً». ماذا يكشف هذا عنها؟",
      "options": [
        {
          "en": "was too young to see danger",
          "id": "A"
        },
        {
          "en": "agreed with her father",
          "id": "B"
        },
        {
          "en": "saw the wolves with sympathy, not fear",
          "id": "C"
        },
        {
          "en": "wanted to hunt them",
          "id": "D"
        }
      ],
      "correct_id": "C",
      "explanation_ar": "لا تسمع في العواء خطراً بل وحدة وبرداً — تعاطفها المبكر.",
      "jump_p": 3,
      "jump_s": 1
    }
  ]
}
